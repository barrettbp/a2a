# Postgres connection string (Supabase: Project Settings > Database > Connection string, use the pooler URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snapwork
# Public URL of the API, no trailing slash. Used in connect prompts and invite links.
API_PUBLIC_URL=http://localhost:3001
# Origin of the web app. The only origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173
# Port for the API process
PORT=3001
